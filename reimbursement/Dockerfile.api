# syntax=docker/dockerfile:1.7
#
# Reimbursement API image — Bun + Elysia + Prisma.
#
# Layout:
#   1. deps       — install workspace deps with bun.lock frozen
#   2. build      — generate Prisma client and run tsc --noEmit
#   3. runtime    — slim runtime image with the bun user (UID 1000)
#
# The api uses workspace package `@reimbursement/shared`, so we must copy the
# whole workspace tree (root package.json + apps/api + packages/shared) for
# `bun install` to resolve workspace symlinks correctly.

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — install deps for the workspace
# ─────────────────────────────────────────────────────────────────────────────
FROM oven/bun:1.4 AS deps

WORKDIR /app

# Workspace manifests (root + each workspace member). Copying these alone
# lets bun resolve the dependency graph; copying lockfile pins versions.
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

RUN bun install --frozen-lockfile

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — build (Prisma client generation + typecheck)
# ─────────────────────────────────────────────────────────────────────────────
FROM oven/bun:1.4 AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules

# Source for the api workspace + the shared package it depends on.
# We also copy the web workspace tsconfig to keep the workspace coherent
# during typecheck if any cross-references exist.
COPY package.json bun.lock ./
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared

# Prisma client output lands at apps/api/src/generated/prisma per schema.prisma.
RUN cd apps/api && bunx prisma generate --schema=prisma/schema.prisma

# Typecheck deliberately does NOT run here: the deploy workflow's contract job
# runs the full reimbursement typecheck IN PARALLEL with this build (same gate,
# zero build time), and PRs are gated by reimbursement-ci. Re-adding tsc here
# only re-buys ~15s per build.


# ─────────────────────────────────────────────────────────────────────────────
# Stage 3 — runtime
# ─────────────────────────────────────────────────────────────────────────────
FROM oven/bun:1.4-slim AS runtime

LABEL org.opencontainers.image.source=https://github.com/thehfhotel/payroll
LABEL org.opencontainers.image.licenses=Proprietary

# curl is needed for the HEALTHCHECK probe below. openssl ships with the bun
# image but Prisma's query engine wants libssl at runtime — bun:slim already
# carries it, so no extra install.
#
# ghostscript is what lets ImageMagick rasterize a PDF. A receipt shared from
# an iPhone is very often a PDF (Notes → Scan Documents produces one), and every
# consumer in this app renders `photoPath` in an <img> — so a PDF that is not
# converted to an image on the way in is a broken picture in three screens.
# ImageMagick alone CANNOT do it: `convert foo.pdf` delegates to Ghostscript.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates imagemagick ghostscript \
    && rm -rf /var/lib/apt/lists/*

# Debian's ImageMagick ships with the PDF/PS coders DISABLED by policy — the
# blanket response to CVE-2016-3714 ("ImageTragick"), which was a shell-injection
# hole in the *delegate* mechanism. Without re-enabling PDF, every rasterize
# attempt fails with "attempt to perform an operation not allowed by the
# security policy `PDF'" and shared PDFs silently arrive unpreviewable.
#
# Re-enabling reads alarming, so state exactly what is and is not true here:
# the risk of the original CVE was untrusted input reaching Ghostscript through
# ImageMagick's delegates. That input is still untrusted — a PDF from a phone —
# so this does NOT rely on the file being safe. What makes it acceptable is the
# rest of the setup: the modern Ghostscript in this image has -dSAFER on by
# default (no shell-out, no filesystem escape), `convert` runs as the unprivileged
# `bun` user in a container with no secrets on disk beyond this app's own, and
# reaching it at all requires an authenticated share token AND a Cloudflare
# Access service token. We re-enable READ on PDF only — writing PDFs stays
# forbidden, since nothing here has any reason to produce one.
RUN set -eux; \
    for policy in /etc/ImageMagick-6/policy.xml /etc/ImageMagick-7/policy.xml; do \
      if [ -f "$policy" ]; then \
        sed -i 's|<policy domain="coder" rights="none" pattern="PDF" />|<policy domain="coder" rights="read" pattern="PDF" />|' "$policy"; \
      fi; \
    done

# The oven/bun image ships a `bun` user at UID 1000; everything under /app is
# created AS that user, or copied in with `--chown`, so the runtime user owns
# its files from the moment they exist.
#
# This used to be a single `RUN chown -R bun:bun /app` at the end of the stage.
# On overlayfs a chown is a write, so that one line copied every file under
# /app up into a new layer — 355 MB of a 1023 MB image, its largest layer —
# and broke the hardlinks bun's install backend uses between its store and
# node_modules (each copied-up file becomes its own inode). Setting ownership
# at creation time leaves nothing to rewrite. Verified by the api-boot-smoke
# job in .github/workflows/reimbursement-ci.yml, which boots this image against
# a postgres and checks /health and an uploads write as the runtime user.
RUN mkdir -p /app && chown bun:bun /app
WORKDIR /app
USER bun

ENV NODE_ENV=production \
    API_PORT=3001

# Production deps only (omit dev). Re-running bun install with --production
# against the same workspace manifest produces a slimmer node_modules.
COPY --chown=bun:bun package.json bun.lock ./
COPY --chown=bun:bun apps/api/package.json ./apps/api/
COPY --chown=bun:bun apps/web/package.json ./apps/web/
COPY --chown=bun:bun packages/shared/package.json ./packages/shared/
RUN bun install --frozen-lockfile --production

# Application source — server entrypoint, routes, helpers.
COPY --chown=bun:bun apps/api/src ./apps/api/src
# Workspace package source (linked into apps/api/node_modules by bun install).
COPY --chown=bun:bun packages/shared ./packages/shared

# Generated Prisma client (already produced in the build stage).
COPY --chown=bun:bun --from=build /app/apps/api/src/generated ./apps/api/src/generated

# Schema + migrations + prisma.config.ts so `prisma migrate deploy` works at
# container start (entrypoint script handles invocation).
COPY --chown=bun:bun apps/api/prisma ./apps/api/prisma
COPY --chown=bun:bun apps/api/prisma.config.ts ./apps/api/prisma.config.ts

# One-off operational scripts (CSV imports, data migrations, etc.). Run via
#   docker run … bun run scripts/<name>.ts
# Not part of the server start path — the entrypoint never invokes these.
COPY --chown=bun:bun apps/api/scripts ./apps/api/scripts

# Uploads directory — receipt photos and transfer screenshots persist here
# via the named volume mounted by docker-compose.production.yml. Created as
# the runtime user (see above), so it is writable without a chown.
RUN mkdir -p /app/apps/api/uploads

# Entrypoint runs prisma migrate deploy then exec's into bun. COPY ignores
# USER (it always writes as root), which is what /usr/local/bin needs.
COPY --chmod=0755 apps/api/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS --max-time 3 http://localhost:3001/health > /dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
# Path is relative to the entrypoint's cwd (apps/api), where prisma's
# migrate command also runs.
CMD ["bun", "run", "src/index.ts"]
